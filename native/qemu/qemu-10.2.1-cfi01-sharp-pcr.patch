+/* Optional Sharp partition configuration latch. This does not add partition
+ * timing or asynchronous read-while-write execution to the CFI01 model. */
+static bool pflash_sharp_pcr_needed(void *opaque)
+{
+    return ((PFlashCFI01 *)opaque)->sharp_pcr_enabled;
+}
+
+static int pflash_sharp_pcr_post_load(void *opaque, int version_id)
+{
+    PFlashCFI01 *pfl = opaque;
+    (void)version_id;
+    return pfl->sharp_pcr_enabled && !(pfl->sharp_pcr & ~0x0700) ? 0 : -EINVAL;
+}
+
+static const VMStateDescription vmstate_pflash_sharp_pcr = {
+    .name = "pflash_cfi01/sharp-pcr",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pflash_sharp_pcr_needed,
+    .post_load = pflash_sharp_pcr_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_EQUAL(sharp_pcr_reset, PFlashCFI01, "Sharp PCR orientation differs"),
+        VMSTATE_UINT16(sharp_pcr, PFlashCFI01),
+        VMSTATE_UINT64(sharp_pcr_setup_address, PFlashCFI01),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void pflash_sharp_pcr_reset(PFlashCFI01 *pfl)
+{
+    pfl->sharp_pcr = pfl->sharp_pcr_reset;
+    pfl->sharp_pcr_setup_address = UINT64_MAX;
+}
+
+static bool pflash_sharp_pcr_set(PFlashCFI01 *pfl, hwaddr offset,
+                                uint32_t value, int width)
+{
+    if (!pfl->sharp_pcr_enabled || pfl->bank_width != 2 ||
+        pfl->device_width != 2 || pfl->max_device_width != 2 || width != 2 ||
+        value != 0x04 || (offset & 1) || offset != pfl->sharp_pcr_setup_address) {
+        return false;
+    }
+    /* The flash address pins A15..A0 carry PCRC, rather than the data bus.
+     * ARM byte addressing puts those pins in offset bits 16..1. */
+    pfl->sharp_pcr = (offset >> 1) & 0x0700;
+    pfl->status = 0x80;
+    return true;
+}
+
+static bool pflash_sharp_locks_needed(void *opaque)
+{
+    return ((PFlashCFI01 *)opaque)->sharp_locks_enabled;
+}
+
+static int pflash_sharp_locks_post_load(void *opaque, int version_id)
+{
+    PFlashCFI01 *pfl = opaque;
+    (void)version_id;
+    if (!pfl->sharp_locks_enabled || !pfl->sharp_lock_state) {
+        return -EINVAL;
+    }
+    for (unsigned i = 0; i < pfl->nb_blocs; i++) {
+        if (pfl->sharp_lock_state[i] & ~3) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_pflash_sharp_locks = {
+    .name = "pflash_cfi01/sharp-locks",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pflash_sharp_locks_needed,
+    .post_load = pflash_sharp_locks_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_EQUAL(nb_blocs, PFlashCFI01, "Sharp block count differs"),
+        VMSTATE_UINT8_EQUAL(sharp_wp_migration_level, PFlashCFI01, "Sharp WP# differs"),
+        VMSTATE_UINT64(sharp_pcr_setup_address, PFlashCFI01),
+        VMSTATE_VARRAY_UINT32(sharp_lock_state, PFlashCFI01, nb_blocs, 1,
+                             vmstate_info_uint8, uint8_t),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static uint8_t pflash_sharp_block_state(PFlashCFI01 *pfl, hwaddr offset)
+{
+    if (!pfl->sharp_locks_enabled) {
+        return 0;
+    }
+    if (!pfl->sector_len || !pfl->sharp_lock_state ||
+        offset / pfl->sector_len >= pfl->nb_blocs) {
+        return 3;
+    }
+    return pfl->sharp_lock_state[offset / pfl->sector_len] & 3;
+}
+
+static bool pflash_sharp_lock_command(PFlashCFI01 *pfl, hwaddr offset,
+                                    uint32_t value, int width)
+{
+    unsigned cmd = value & 0xff;
+    if (!pfl->sharp_locks_enabled || (cmd != 1 && cmd != 0xd0 && cmd != 0x2f)) {
+        return false;
+    }
+    if (width != 2 || value != cmd || (offset & 1) ||
+        offset != pfl->sharp_pcr_setup_address || !pfl->sector_len ||
+        !pfl->sharp_lock_state || offset / pfl->sector_len >= pfl->nb_blocs) {
+        pfl->status |= 0xb0; /* Ready, invalid command sequence. */
+        return true;
+    }
+    uint8_t *state = &pfl->sharp_lock_state[offset / pfl->sector_len];
+    if (cmd == 1) {
+        *state |= 1;
+    } else if (cmd == 0x2f) {
+        *state |= 3;
+    } else if (!(*state & 2) || pfl->sharp_wp_high) {
+        *state &= ~1;
+    }
+    pfl->status |= 0x80;
+    return true;
+}
+
+static bool pflash_sharp_program_frame(PFlashCFI01 *pfl, hwaddr offset, int width)
+{
+    if (!pfl->sharp_pcr_enabled && !pfl->sharp_locks_enabled) {
+        return true;
+    }
+    uint64_t total = pfl->sector_len * pfl->nb_blocs;
+    if (width != 2 || (offset & 1) || total < 2 || offset > total - 2) {
+        pfl->status |= 0x92;
+        return false;
+    }
+    return true;
+}
+
+static bool pflash_sharp_program_blocked(PFlashCFI01 *pfl, hwaddr offset)
+{
+    if (pflash_sharp_block_state(pfl, offset) & 1) {
+        pfl->status |= 0x92; /* Ready, programming/protection error. */
+        return true;
+    }
+    return false;
+}
+
+static bool pflash_deferred_erase_enabled(PFlashCFI01 *pfl)
+{
+    return pfl->defer_erase_confirm || pfl->sharp_pcr_enabled || pfl->sharp_locks_enabled;
+}
+
+static bool pflash_deferred_erase_needed(void *opaque)
+{
+    return pflash_deferred_erase_enabled(opaque);
+}
+
+static int pflash_deferred_erase_post_load(void *opaque, int version_id)
+{
+    PFlashCFI01 *pfl = opaque;
+    uint64_t total = pfl->sector_len * pfl->nb_blocs;
+    uint64_t address = pfl->sharp_erase_address;
+    (void)version_id;
+    return pflash_deferred_erase_enabled(pfl) &&
+        (address == UINT64_MAX || (pfl->sector_len && address % pfl->sector_len == 0 &&
+         total >= pfl->sector_len && address <= total - pfl->sector_len)) ? 0 : -EINVAL;
+}
+
+static const VMStateDescription vmstate_pflash_deferred_erase = {
+    .name = "pflash_cfi01/deferred-erase",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pflash_deferred_erase_needed,
+    .post_load = pflash_deferred_erase_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_EQUAL(nb_blocs, PFlashCFI01, "Flash block count differs"),
+        VMSTATE_UINT64_EQUAL(sector_len, PFlashCFI01, "Flash sector length differs"),
+        VMSTATE_UINT64(sharp_erase_address, PFlashCFI01),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+/* This opt-in class completes WSM work synchronously. A suspend/resume
+ * arriving after completion preserves errors and reports no suspended work. */
+static bool pflash_sync_completed_control(PFlashCFI01 *pfl, uint32_t value, int width)
+{
+    if (!pflash_deferred_erase_enabled(pfl) || pfl->wcycle || width != 2 ||
+        (value != 0xb0 && value != 0xd0) || pfl->cmd == 0x90 || pfl->cmd == 0x98) {
+        return false;
+    }
+    pfl->status = (pfl->status & ~0x44) | 0x80;
+    return true;
+}
+
+static bool pflash_sharp_status_mirror_needed(void *opaque)
+{
+    return ((PFlashCFI01 *)opaque)->sharp_status_mirror;
+}
+
+static const VMStateDescription vmstate_pflash_sharp_status_mirror = {
+    .name = "pflash_cfi01/sharp-status-mirror",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pflash_sharp_status_mirror_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_EQUAL(sharp_status_mirror, PFlashCFI01, "Sharp status wiring differs"),
+        VMSTATE_END_OF_LIST()
+    }
+};
