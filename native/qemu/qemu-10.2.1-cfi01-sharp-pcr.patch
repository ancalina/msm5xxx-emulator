+/* Sharp erase is armed by 20h and modifies the array only after D0h. The
+ * existing generic CFI01 behavior is retained when both optional classes are off. */
+static bool pflash_sharp_erase_start(PFlashCFI01 *pfl, hwaddr offset,
+                                   uint32_t value, int width)
+{
+    if (!pflash_deferred_erase_enabled(pfl)) {
+        return false;
+    }
+    pfl->sharp_erase_address = UINT64_MAX;
+    if (width == 2 && value == 0x20 && !(offset & 1) && pfl->sector_len &&
+        !(pfl->sector_len & (pfl->sector_len - 1)) &&
+        offset / pfl->sector_len < pfl->nb_blocs) {
+        pfl->sharp_erase_address = offset & ~(pfl->sector_len - 1);
+    }
+    return true;
+}
+
+static bool pflash_sharp_erase_finish(PFlashCFI01 *pfl, hwaddr offset,
+                                    uint32_t value, int width)
+{
+    if (!pflash_deferred_erase_enabled(pfl)) {
+        return false;
+    }
+    uint64_t address = pfl->sharp_erase_address;
+    pfl->sharp_erase_address = UINT64_MAX;
+    if (address == UINT64_MAX || !pfl->sector_len || width != 2 ||
+        value != 0xd0 || (offset & 1) ||
+        offset / pfl->sector_len >= pfl->nb_blocs ||
+        (offset & ~(pfl->sector_len - 1)) != address) {
+        pfl->status |= 0xb0;
+    } else if (pflash_sharp_block_state(pfl, address) & 1) {
+        pfl->status |= 0xa2;
+    } else if (pfl->ro) {
+        pfl->status |= 0xa0;
+    } else {
+        memset((uint8_t *)pfl->storage + address, 0xff, pfl->sector_len);
+        pflash_update(pfl, address, pfl->sector_len);
+        pfl->status |= 0x80;
+    }
+    return true;
+}
