+static bool pflash_w18_needed(void *opaque)
+{
+    return ((PFlashCFI01 *)opaque)->w18;
+}
+
+static int pflash_w18_post_load(void *opaque, int version_id)
+{
+    PFlashCFI01 *pfl = opaque;
+    unsigned i;
+    if (!pfl->w18) {
+        return -EINVAL;
+    }
+    for (i = 0; i < 16; i++) {
+        if ((pfl->w18_mode[i] != 0 && pfl->w18_mode[i] != 0x70 &&
+             pfl->w18_mode[i] != 0x90 && pfl->w18_mode[i] != 0x98) ||
+            (pfl->w18_cycle[i] != 0 && pfl->w18_cycle[i] != 0x20 &&
+             pfl->w18_cycle[i] != 0x40 && pfl->w18_cycle[i] != 0x60) ||
+            pfl->w18_address[i] >= 0x800000) {
+            return -EINVAL;
+        }
+    }
+    for (i = 0; i < 135; i++) {
+        if (pfl->w18_locks[i] & ~3) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
