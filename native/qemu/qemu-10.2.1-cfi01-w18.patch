+/* W18 partitions have independent read modes. Commands complete synchronously;
+ * shortcut: operation timing and suspend are not modelled, upgrade when timed
+ * flash users require them. */
+static unsigned pflash_w18_block(hwaddr offset)
+{
+    return offset < 0x10000 ? offset / 0x2000 : 8 + (offset - 0x10000) / 0x10000;
+}
+
+static hwaddr pflash_w18_block_base(hwaddr offset)
+{
+    return offset < 0x10000 ? offset & ~UINT64_C(0x1fff) : offset & ~UINT64_C(0xffff);
+}
+
+static bool pflash_w18_sync(PFlashCFI01 *pfl, hwaddr offset, size_t length)
+{
+    hwaddr start = QEMU_ALIGN_DOWN(offset, BDRV_SECTOR_SIZE);
+    hwaddr end = QEMU_ALIGN_UP(offset + length, BDRV_SECTOR_SIZE);
+    int ret;
+    if (!pfl->blk) {
+        return true;
+    }
+    ret = blk_pwrite(pfl->blk, start, end - start, pfl->storage + start, 0);
+    if (ret < 0) {
+        error_report("W18 flash update failed: %s", strerror(-ret));
+        return false;
+    }
+    return true;
+}
+
+static uint32_t pflash_w18_read(PFlashCFI01 *pfl, hwaddr offset, unsigned width, int be)
+{
+    unsigned part = offset >> 19, mode = pfl->w18_mode[part];
+    uint32_t result = 0;
+    unsigned i;
+    if (!mode) {
+        return pflash_data_read(pfl, offset, width, be);
+    }
+    for (i = 0; i < width; i += 2) {
+        hwaddr address = offset + i;
+        uint32_t word;
+        if (mode == 0x90) {
+            switch ((address >> 1) & 0xff) {
+            case 0: word = pfl->ident0; break;
+            case 1: word = pfl->ident1; break;
+            case 2: word = pfl->w18_locks[pflash_w18_block(address)]; break;
+            default: word = 0; break;
+            }
+        } else if (mode == 0x98) {
+            word = pflash_cfi_query(pfl, address);
+        } else {
+            word = pfl->w18_status[part];
+        }
+        if (width == 1) {
+            result = (word >> ((offset & 1) * 8)) & 0xff;
+        } else {
+            result |= (word & 0xffff) << (i * 8);
+        }
+    }
+    return result;
+}
+
+static void pflash_w18_write(PFlashCFI01 *pfl, hwaddr offset, uint32_t value, unsigned width)
+{
+    unsigned part = offset >> 19, block = pflash_w18_block(offset);
+    uint8_t *status = &pfl->w18_status[part];
+    uint8_t *cycle = &pfl->w18_cycle[part];
+    uint8_t *mode = &pfl->w18_mode[part];
+    uint8_t *media = pfl->storage;
+    hwaddr base = pflash_w18_block_base(offset);
+    size_t length = offset < 0x10000 ? 0x2000 : 0x10000;
+    uint16_t current;
+
+    if (width != 2 || (offset & 1)) {
+        *status |= 0xb0;
+        *mode = 0x70;
+        *cycle = 0;
+        return;
+    }
+    if (*cycle) {
+        unsigned pending = *cycle;
+        *cycle = 0;
+        *mode = 0x70;
+        if (pending == 0x40) {
+            current = lduw_le_p(media + offset);
+            if (pfl->w18_locks[block] & 1) {
+                *status |= 0x92;
+            } else if (pfl->ro || (current & value) != value) {
+                *status |= 0x90;
+            } else {
+                stw_le_p(media + offset, value);
+                if (!pflash_w18_sync(pfl, offset, 2)) {
+                    *status |= 0x90;
+                }
+            }
+        } else if (pending == 0x20) {
+            if (value != 0xd0 || base != pfl->w18_address[part]) {
+                *status |= 0xb0;
+            } else if (pfl->w18_locks[block] & 1) {
+                *status |= 0xa2;
+            } else if (pfl->ro) {
+                *status |= 0xa0;
+            } else {
+                memset(media + base, 0xff, length);
+                if (!pflash_w18_sync(pfl, base, length)) {
+                    *status |= 0xa0;
+                }
+            }
+        } else if (pending == 0x60) {
+            if (base != pfl->w18_address[part]) {
+                *status |= 0xb0;
+            } else if (value == 1) {
+                pfl->w18_locks[block] |= 1;
+            } else if (value == 0x2f) {
+                pfl->w18_locks[block] |= 3;
+            } else if (value == 0xd0) {
+                /* shortcut: WP# is deasserted; upgrade when its board wiring is known. */
+                pfl->w18_locks[block] &= 2;
+            } else {
+                *status |= 0x92;
+            }
+        }
+        *status |= 0x80;
+        return;
+    }
+    switch (value) {
+    case 0xff: *mode = 0; break;
+    case 0x50: *status = (*status & 0x44) | 0x80; *mode = 0x70; break;
+    case 0x70: case 0x90: case 0x98: *mode = value; break;
+    case 0x10: case 0x40: *cycle = 0x40; *mode = 0x70; break;
+    case 0x20: case 0x60:
+        *cycle = value;
+        *mode = 0x70;
+        pfl->w18_address[part] = base;
+        break;
+    case 0xb0: case 0xd0: *mode = 0x70; *status |= 0x80; break;
+    default: *mode = 0x70; *status |= 0xb0; break;
+    }
+}
