--- a/include/qemu/osdep.h
+++ b/include/qemu/osdep.h
@@ -870,5 +870,27 @@
 #endif /* !HAVE_SYSTEM_FUNCTION */
 
+/* Embedded iOS QEMU owns threads, never the application's process lifetime.
+ * Do not interpose libc globally: only QEMU translation units see these names.
+ * One invocation per app lifetime; fatal exits may intentionally leak state.
+ */
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+#include <pthread.h>
+static inline __attribute__((noreturn)) void msm5xxx_ios_thread_exit(int status)
+{
+    pthread_exit((void *)(intptr_t)status);
+    __builtin_unreachable();
+}
+static inline int msm5xxx_ios_ignore_atexit(void (*callback)(void))
+{
+    (void)callback;
+    return 0;
+}
+#define exit msm5xxx_ios_thread_exit
+#define _exit msm5xxx_ios_thread_exit
+#define _Exit msm5xxx_ios_thread_exit
+#define atexit msm5xxx_ios_ignore_atexit
+#endif
+
 #ifdef __cplusplus
 }
 #endif
