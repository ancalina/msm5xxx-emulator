+static void msm5xxx_ios_quit_bh(void *opaque)
+{
+    (void)opaque;
+    /* As qmp_quit: host quit must exit even under -no-shutdown (pause action). */
+    shutdown_action = SHUTDOWN_ACTION_POWEROFF;
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+}
+
+void msm5xxx_qemu_request_quit(void)
+{
+    /* Never wait for BQL on the Python caller. The main AioContext holds it. */
+    AioContext *ctx = qemu_get_aio_context();
+    if (ctx) {
+        aio_bh_schedule_oneshot(ctx, msm5xxx_ios_quit_bh, NULL);
+    }
+}
