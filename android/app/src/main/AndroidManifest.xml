<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_full"
        android:roundIcon="@mipmap/ic_launcher_full"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MSM5xxx"
        android:usesCleartextTraffic="false">
        <provider android:name=".CaptureProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false" android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".LibraryActivity"
            android:exported="true" />
        <activity-alias android:name=".FullIcon" android:targetActivity=".LibraryActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_full" android:roundIcon="@mipmap/ic_launcher_full">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Simple" android:targetActivity=".LibraryActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_simple" android:roundIcon="@mipmap/ic_launcher_simple">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
